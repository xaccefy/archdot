/**
 * dwm Color Scheme (RazoBeckett rice)
 * SchemeNorm = #bbbbbb on #222222, SchemeSel = #eeeeee on #005577
 **/

* {
    background:     #222222E6;
    background-alt: #262626E0;
    foreground:     #bbbbbbFF;
    selected:       #005577E6;   /* selected row = cyan block, like a dwm tag */
    active:         #42be65E6;
    urgent:         #cc6666E6;
}
