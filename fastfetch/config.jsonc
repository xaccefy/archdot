{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // ultra-minimal: no logo, 9 modules, your teal palette
  // inspo: sid3425/clean-fastfetch, rene-nunez gist, daniloscimone/fastfetch-config
  "logo": {
    "type": "none",
    "padding": {
      "top": 1
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 9,
      "type": "string"
    },
    "color": {
      "keys": "#08bdba",
      "title": "#f4f4f4"
    },
    "percent": {
      "type": 1
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}",
      "color": {
        "user": "#f4f4f4",
        "at": "#525252",
        "host": "#08bdba"
      }
    },
    {
      "type": "separator",
      "string": "──────────────",
      "outputColor": "#525252"
    },
    {
      "type": "os",
      "key": " os",
      "keyColor": "#08bdba",
      "format": "{name} {version}"
    },
    {
      "type": "kernel",
      "key": " ker",
      "keyColor": "#78a9ff",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "󰅐 up",
      "keyColor": "#be95ff"
    },
    {
      "type": "shell",
      "key": " sh",
      "keyColor": "#08bdba",
      "format": "{process-name}"
    },
    {
      "type": "cpu",
      "key": " cpu",
      "keyColor": "#be95ff",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": " mem",
      "keyColor": "#78a9ff",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": " disk",
      "keyColor": "#ff832b",
      "folders": "/",
      "format": "{size-used} / {size-total}"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 0
    }
  ]
}
