// -*- mode: jsonc -*-
{
  "layer": "top",
  "position": "top",
  "height": 39,
  // Compact float: the layer-shell surface stretches edge-to-edge and the
  // left/right margins squeeze the visible bar toward the center while the
  // modules keep their three-section layout. Rendered by render.sh.
  "spacing": 4,
  // Floating margins live here (layer-shell), not in CSS margins -- CSS margin
  // just paints black strips on the still-full-width surface.
  "margin-top": 7,
  "margin-left": 320,
  "margin-right": 320,

  // Choose the order of the modules.
  // dwm bar: tags on the left, focused-window title dead center
  // (titlestyle=1), status blocks on the right -- so the clock joins the
  // status side and the window module takes the center.
  "modules-left": ["custom/user", "hyprland/workspaces"],
  "modules-center": ["hyprland/window"],

  // Bluetooth lives in the tray: blueman-applet registers a StatusNotifierItem
  // that waybar's tray module renders, so there is one bluetooth icon with
  // blueman's full device menu on click. A separate "bluetooth" module here
  // would draw a second, redundant glyph.
  "modules-right": ["custom/runcat", "custom/sep1", "memory", "custom/sep2", "pulseaudio", "custom/sep3", "custom/trayl", "tray", "custom/trayr", "custom/sep4", "battery", "custom/sep5", "clock"],

  // Modules configuration
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    // dwm draws a small square on every tag that holds a window: filled on
    // the selected tag, hollow on the rest. format-icons maps per-state.
    "format": "{icon}{name}",
    "format-icons": {
      "active": "■ ",
      "default": "□ ",
      "urgent": "▲ ",
    },
    // No persistent-workspaces: empty tags stay hidden, like dwm's
    // hide_vacant_tags patch -- only occupied + focused tags show.
  },
  // Systray wrapped in literal brackets via two label modules -- waybar's
  // tray module can't wrap its icons in text, so [ and ] flank it.
  "custom/trayl": { "format": "[", "tooltip": false },
  "custom/trayr": { "format": "]", "tooltip": false },
  // dwmblocks-style separators between status blocks.
  "custom/sep1": { "format": "|", "tooltip": false },
  "custom/sep2": { "format": "|", "tooltip": false },
  "custom/sep3": { "format": "|", "tooltip": false },
  "custom/sep4": { "format": "|", "tooltip": false },
  "custom/sep5": { "format": "|", "tooltip": false },
  "tray": {
    "icon-size": 19,
    "spacing": 6,
    // "icons": {
    //   "blueman": "bluetooth",
    //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
    // }
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%Y-%m-%d %H:%M}",
    // One brace group only: waybar's clock module parses a single format
    // arg, and a second {..} is read as an arg-id and fails the parse.
    "tooltip-format": "<big>{:%A, %B %d — %H:%M}</big>",
  },
  "custom/runcat": {
    "exec": "python3 $HOME/.local/lib/waybar/runcat-text/main.py",
    "return-type": "json",
  },
  // Focused window's title + app icon, centered -- dwm titlestyle=1 + the
  // winicon patch. Built-in module, so it updates on Hyprland's event socket
  // instead of polling.
  "hyprland/window": {
    "icon": true,
    "icon-size": 18,
    "format": "{title}",
    "max-length": 60,
  },
  "memory": {
    "format": "ram: {percentage}%",
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "format-muted": "󰖁",
    "scroll-step": 5,
    "max-volume": 100,
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip-format": "{desc}",
  },
  "battery": {
    "states": {
      "warning": 20,
      "critical": 10,
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
    "format-alt": "{icon} {time}",
    "format-time": "{H}:{M}",
  },
  "custom/user": {
    "format": "λ",
    "tooltip-format": "Application launcher",
    "on-click": "rofi -show drun -replace -i -theme ~/.config/rofi/launchers/type-1/glass-compact.rasi",
  },
}
