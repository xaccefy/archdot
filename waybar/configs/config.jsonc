// -*- mode: jsonc -*-
{
  "layer": "top",
  "position": "top",
  "height": 37,
  "spacing": 4,

  // Choose the order of the modules
  "modules-left": ["custom/user", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],

  "modules-right": ["custom/runcat", "memory", "pulseaudio", "bluetooth", "tray", "battery"],

  // Modules configuration
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{name}",
    "persistent-workspaces": {
      "*": 9,
    },
  },
  "tray": {
    "icon-size": 22,
    "spacing": 6,
    // "icons": {
    //   "blueman": "bluetooth",
    //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
    // }
  },
  "clock": {
    "format": "{:%b %d}",
    "format-alt": "{:%Y-%m-%d %H:%M}",
    "tooltip-format": "<big>{:%A, %B %d}</big>\n<big>{:%H:%M}</big>",
  },
  // Bluetooth icon set. "format" is the idle/on state, "format-connected" is
  // shown once a device is paired, "format-disabled" when the radio is off.
  // "format-no-controller" hides the icon entirely on machines with no
  // adapter, so the bar does not show a dead glyph on desktop hardware.
  "bluetooth": {
    "format": "<span size='12075'>󰂯</span>",
    "format-disabled": "<span size='12075'>󰂲</span>",
    "format-connected": "<span size='12075'></span>",
    "format-no-controller": "",
    "tooltip-format": "Bluetooth: {num_connections} connected",
    "on-click": "ghostty -e bluetoothctl",
  },
  "custom/runcat": {
    "exec": "python3 $HOME/.local/lib/waybar/runcat-text/main.py",
    "return-type": "json",
  },
  // Icon of the focused window's app, right of the workspace list.
  // Built-in module, so it updates on Hyprland's event socket instead of polling.
  // An empty format hides the label and leaves only the app icon.
  // Note: waybar puts the tooltip on that (now hidden) label, so there is no
  // hover text in this mode -- set a format to get one back.
  "hyprland/window": {
    "icon": true,
    "icon-size": 25,
    "format": "",
  },
  "memory": {
    "format": "ram: {percentage}%",
  },
  "pulseaudio": {
    "format": "󰕾 {volume}%",
    "format-muted": "󰖁",
    "scroll-step": 5,
    "max-volume": 100,
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip-format": "{desc}",
  },
  "battery": {
    "states": {
      "good": 95,
      "warning": 20,
      "critical": 10,
    },
    "format": "battery: {capacity}%",
    "format-charging": "plugged: {capacity}%",
    "format-plugged": "plugged: {capacity}%",
    "format-alt": "battery: {time}",
    "format-time": "{H}:{M}",
  },
  "custom/user": {
    "format": "fx",
    "tooltip": "Application launcher",
    "on-click": "rofi -show drun -replace -i -theme ~/.config/rofi/launchers/type-1/glass-compact.rasi",
  },
}
