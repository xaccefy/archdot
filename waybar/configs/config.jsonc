// -*- mode: jsonc -*-
{
  "layer": "top",
  "position": "top",
  "height": 40,
  // Compact float: the layer-shell surface stretches edge-to-edge and the
  // left/right margins squeeze the visible bar toward the center while the
  // modules keep their three-section layout. Rendered by render.sh.
  "spacing": 4,
  // Floating margins live here (layer-shell), not in CSS margins -- CSS margin
  // just paints black strips on the still-full-width surface.
  "margin-top": 7,
  "margin-left": 320,
  "margin-right": 320,

  // Choose the order of the modules
  "modules-left": ["custom/user", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],

  // Bluetooth lives in the tray: blueman-applet registers a StatusNotifierItem
  // that waybar's tray module renders, so there is one bluetooth icon with
  // blueman's full device menu on click. A separate "bluetooth" module here
  // would draw a second, redundant glyph.
  "modules-right": ["custom/runcat", "memory", "pulseaudio", "tray", "battery"],

  // Modules configuration
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{name}",
    "persistent-workspaces": {
      "*": 9,
    },
  },
  // The tray used to be wrapped in literal [ ] via two custom modules -- now
  // the stylesheet gives it a raised surface-colored pill instead.
  // (waybar's tray module can't wrap its icons in text; a bg chip can.)
  "tray": {
    "icon-size": 23,
    "spacing": 6,
    // "icons": {
    //   "blueman": "bluetooth",
    //   "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
    // }
  },
  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%Y-%m-%d %H:%M}",
    // One brace group only: waybar's clock module parses a single format
    // arg, and a second {..} is read as an arg-id and fails the parse.
    "tooltip-format": "<big>{:%A, %B %d — %H:%M}</big>",
  },
  "custom/runcat": {
    "exec": "python3 $HOME/.local/lib/waybar/runcat-text/main.py",
    "return-type": "json",
  },
  // Icon of the focused window's app, right of the workspace list.
  // Built-in module, so it updates on Hyprland's event socket instead of polling.
  // An empty format hides the label and leaves only the app icon.
  // Note: waybar puts the tooltip on that (now hidden) label, so there is no
  // hover text in this mode -- set a format to get one back.
  "hyprland/window": {
    "icon": true,
    "icon-size": 26,
    "format": "",
  },
  "memory": {
    "format": "󰍛 {percentage}%",
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "format-muted": "󰖁",
    "scroll-step": 5,
    "max-volume": 100,
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip-format": "{desc}",
  },
  "battery": {
    "states": {
      "warning": 20,
      "critical": 10,
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
    "format-alt": "{icon} {time}",
    "format-time": "{H}:{M}",
  },
  "custom/user": {
    "format": "λ",
    "tooltip-format": "Application launcher",
    "on-click": "rofi -show drun -replace -i -theme ~/.config/rofi/launchers/type-1/glass-compact.rasi",
  },
}
