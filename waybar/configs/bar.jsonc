{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 39,
  "border-radius": 25,
  "margin-right": 0,
  "margin-left": 0,
  "margin-top": 0,
  "modules-left": ["custom/active_window", ],
  "modules-center": [ "group/center3-expander", "hyprland/workspaces", "group/center2-expander" ],
  "modules-right": [
    "tray",
    "custom/separator#blank",
    "custom/separator#dot",
    "temperature",
    "custom/mode",
    "group/right1",
  ],

// GROUPS MODULE

  "group/center2": {
	"orientation": "inherit",
	"modules": [
    "clock",
    "custom/screenrecording-indicator", 
    "custom/update",
    "custom/idle-indicator",
    "custom/notification-silencing-indicator", 
	]
},

  "group/center3": {
	"orientation": "inherit",
	"modules": [
    "cpu",
    "memory",
    "disk",
    "custom/media",
	]
},

  "group/right1": {
	"orientation": "inherit",
	"modules": [
    "pulseaudio",
    "bluetooth",
    "network",
    "battery",
	]
},

// MODULES

  "custom/mode": {
      "exec": "~/.config/waybar/mode.sh",
      "on-click": "~/.config/waybar/mode.sh toggle",
      "return-type": "json",
      "format": "{}"
  },

  "custom/active_window": {
    "exec": "~/.config/waybar/window.sh",
    "return-type": "json",
    "markup": true,
    "on-click": "rofi -show drun -replace -i -theme ~/.config/rofi/launchers/type-1/glass-compact.rasi",
    "on-click-right": "ghostty",
  },
  
  "hyprland/workspaces": {
	  "on-click": "activate",
        "format": "{icon}",
        "format-icons": {
          "default": "",
          "active": "",
          "empty": "",
        },
      "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": [],
      "6": [],
      "7": [],
      "8": [],
    },
	},

  "custom/menu": {
    // "format": "󰹡",
    "format": "<span size='11500'></span>",
    "on-click": "rofi -show drun -replace -i -theme ~/.config/rofi/launchers/type-1/glass-compact.rasi",
    "on-click-right": "ghostty",
    "tooltip-format": "App Menu\n\nSuper + Space"
  },

"temperature": {
  "interval": 2,
  "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
  "input-filename": "temp1_input",
  "critical-threshold": 85,
  "format": " {temperatureC}°",
  "on-click": "ghostty -e btop"
},

"cpu": {
  "interval": 2,
  "format": "{icon} {usage} ",
  "format-icons": ["󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"],
  "on-click": "ghostty -e btop"
},

"memory": {
  "interval": 2,
  "format": "{icon} {percentage} ",
  "format-icons": ["󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"],
  "on-click": "ghostty -e btop"
},

"disk": {
    "interval": 30,
    "format": "󰨣 {percentage_free}%",
    // "format-icons": ["󰪞", "󰪟", "󰪠", "󰪡", "󰪢", "󰪣", "󰪤", "󰪥"],
    "path": "/"
},

"clock": {
    "format": " {:%I:%M %p • %a, %d/%m}",
    "format-alt": "{:%A, %d %B %Y}   ",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
},

  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "<span size='11500'>󰌘</span>",
    "format-disconnected": "<span size='11500'>󰤮</span>",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "ghostty -e nmtui"
  },

  "battery": {
    "format": "{capacity}% {icon}",
    "format-discharging": "{icon}",
    "format-charging": "{icon}",
    "format-plugged": "",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "on-click": "wlogout",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },

  "bluetooth": {
    "format": "<span size='11500'>󰂯</span>",
    "format-disabled": "<span size='11500'>󰂲</span>",
    "format-connected": "<span size='11500'></span>",
    "format-no-controller": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "ghostty -e bluetoothctl"
  },

  "pulseaudio": {
    "format": "<span size='11500'>{icon}</span>",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "default": [
        " ",
        " ",
        " "
      ]
    }
  },
  
  "group/center3-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "center3-group-item"
    },
    "modules": ["custom/expand-iconl", "group/center3"]
  },

  "group/center2-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "transition-left-to-right": false,
      "children-class": "center2-group-item"
    },
    "modules": [ "custom/expand-iconr", "group/center2"]
  },

  "custom/expand-iconl": {
    "format": "     ",
    "tooltip": false
  },

    "custom/expand-iconr": {
    "format": "     ",
    "tooltip": false
  },

  "custom/screenrecording-indicator": {
    "exec": "~/.config/waybar/scripts/screenrec.sh status",
    "on-click": "~/.config/waybar/scripts/screenrec.sh toggle",
    "signal": 8,
    "return-type": "json",
    "interval": 2
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "custom/separator#blank": {
	  "format": " ",
	  "interval": "once",
	  "tooltip": false
},

  "custom/separator#dot": {
	  "format": " ",
	  "interval": "once",
	  "tooltip": false
},

  "custom/idle-indicator": {
    "exec": "~/.config/waybar/scripts/idle.sh status",
    "on-click": "~/.config/waybar/scripts/idle.sh toggle",
    "signal": 9,
    "return-type": "json",
    "interval": 5
  },
  
  "custom/notification-silencing-indicator": {
    "exec": "~/.config/waybar/scripts/notif.sh status",
    "on-click": "~/.config/waybar/scripts/notif.sh toggle",
    "signal": 10,
    "return-type": "json",
    "interval": 5
  },

  "custom/update": {
    "exec": "~/.config/waybar/scripts/updates.sh status",
    "on-click": "ghostty -e paru -Syu",
    "return-type": "json",
    "signal": 7,
    "interval": 3600
  },

"custom/media": {
  "exec": "~/.config/waybar/scripts/media.sh",
  "interval": 2,
  "on-click": "playerctl play-pause"
},

}
