# Neon Cyberpunk — Matrix green
background = #08080c
foreground = #f5f3ff
cursor-color = #ffffff
cursor-text = #08080c
selection-background = #292638
selection-foreground = #f5f3ff

# 16 colors — Neon Cyberpunk
palette = 0=#08080c
palette = 1=#ff2e88
palette = 2=#00ff41
palette = 3=#ff8a00
palette = 4=#00e5ff
palette = 5=#a259ff
palette = 6=#00e5ff
palette = 7=#f5f3ff
palette = 8=#77738f
palette = 9=#ff2e88
palette = 10=#00ff41
palette = 11=#ff8a00
palette = 12=#00e5ff
palette = 13=#a259ff
palette = 14=#00e5ff
palette = 15=#f5f3ff

font-family = "JetBrainsMono Nerd Font"
font-size = 15.5

cursor-style = block
shell-integration-features = no-cursor
resize-overlay = never
background-opacity = 0.91
window-decoration = false
window-padding-x = 10
window-padding-y = 4
confirm-close-surface = false

gtk-tabs-location = bottom

# Ignore OSC 9;4 progress bar sequences (hide the bouncing bar in title)
progress-style = false


# Use a short, dotted GTK application ID so the Wayland app_id / WM_CLASS
# class shows as "com.ghostty" instead of "com.mitchellh.ghostty".
# (GTK requires at least one dot; bare "ghostty" is rejected by Ghostty.)
class = com.ghostty
