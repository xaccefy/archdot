  "window_title_format": "${projectName}${separator}${fileName}",
  "git_panel": {
    "dock": "left"
  },
  "vim_mode": false,
  "collaboration_panel": {
    "button": false
  },
  "vim": {
    "default_mode": "normal",
    "toggle_relative_line_numbers": false
  },
  "disable_ai": true,
  "tab_bar": {
    "show": true
  },
  "terminal": {
    "flexible": false,
    "option_as_meta": false,
    "toolbar": {
      "breadcrumbs": false
    },
    "button": true,
    "dock": "bottom"
  },
  "proxy": "",
  "cli_default_open_behavior": "new_window",
  "icon_theme": {
    "mode": "light",
    "light": "Icons modern material (Dark)",
    "dark": "Icons modern material (Dark)"
  },
  "show_signature_help_after_edits": false,
  "auto_signature_help": false,
  "show_completions_on_input": true,
  "format_on_save": "on",
  "base_keymap": "VSCode",
  "theme": {
    "mode": "dark",
    "light": "Night Owl Light No Italics",
    "dark": "XY-Zed"
  },
  "ui_font_size": 21.0,
  "buffer_font_size": 20.0,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "markdown_preview": {
    "font_size": 18.0,
    "limit_content_width": false,
    "max_width": 1200.0
  },
  "minimap": {
    "show": "never"
  },
  "gutter": {
    "line_numbers": true,
    "min_line_number_digits": 4,
    "breakpoints": true,
    "runnables": false,
    "folds": false
  },
  "project_panel": {
    "folder_indicator": "icon",
    "git_status": true,
    "file_icons": true,
    "entry_spacing": "comfortable",
    "default_width": 240.0,
    "dock": "right"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "title_bar": {
    "show_menus": false
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false,
    "selections_menu": false,
    "agent_review": false,
    "code_actions": false
  },
  "languages": {
    "LaTeX": {
      "soft_wrap": "editor_width"
    },
    "Python": {
      "language_servers": ["pyright", "ruff", "!clangd"]
    }
  },
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "executable": "latexmk",
            "args": ["-pdf", "-interaction=nonstopmode", "-synctex=1", "%f"],
            "onSave": true
          },
          "forwardSearch": {
            "executable": "zathura",
            "args": ["--synctex-forward", "%l:1:%f", "%p"]
          }
        }
      }
    }
  },
  "lsp": {
    "pyright": {
      "settings": {
        "python.analysis.extraPaths": ["/home/xaccefy/.local/lib/python3.14/site-packages"]
      }
    },
    "ruff": {
      "binary": {
        "path": "/home/xaccefy/.local/bin/ruff",
        "arguments": ["server"]
      }
    }
  },
  "theme_overrides": {
    "Carbonfox - blurred": {
      "editor.line_number": "#888888",
      "editor.active_line_number": "#ffffff"
    }
  }
}
