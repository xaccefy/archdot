# Ignore caches, logs, compiled assets
.cache/
*.log
**/*.log
**/Cache/
**/Crashpad/
**/GPUCache/
**/DawnWebGPUCache/
**/Session Storage/
**/Shared Dictionary/
**/Network Persistent State
**/Cookies
**/first_party_sets.db*
**/BrowserMetrics*

# App data / databases
**/*.db
**/*.db-journal
**/*.sqlite
**/*.sqlite-* 
notion.db

# Secrets / tokens (add your own patterns here)
.env
.env.*
!.env.example
.npmrc
.pypirc
.netrc
*.key
*.pem
*.p12
*.asc
*.gpg
*.age
*.token
*.secret
*.local

# Editor / tool backups picked up by sync_back.sh
*.bak
*.prepropo.bak
*.bak-*
*.theme.bak

# Node / build outputs
node_modules/
dist/
build/
.idea/
.DS_Store

# Upstream source clones
waybar/waybar_repo/

# Runtime state written into the (symlinked) config dirs
waybar/.perf
waybar/.mode
waybar/.scale

# render.sh output -- sources are configs/ and styles/, these are regenerated
waybar/config.jsonc
waybar/style.css

# fish universal variables -- written at runtime
fish/fish_variables
